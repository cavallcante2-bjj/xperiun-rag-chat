# OpenAI - usado apenas para embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Anthropic - usado na etapa de Generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Parâmetros de chunking (SPEC.md - Onda 2)
CHUNK_SIZE=350
CHUNK_OVERLAP=40

# Parâmetros de retrieval (SPEC.md - Onda 4)
TOP_K=3

# Pasta com os documentos-fonte (SPEC.md - Agents.md)
DOCS_DIR=docs
